/*
Generated by Text-to-CAD:
An industrial robotic work cell on a rectangular steel base frame, 2.0 m wide, 1.9 m deep and 3.1 m tall overall. A vertical column rises from one corner of the base to the full height. A horizontal gantry beam runs from the top of the column across to the opposite side, supported at its far end by a slender diagonal brace, leaving a large open volume underneath. A boxy control cabinet stands on the base beside the column, and a smaller junction box is mounted on the column at mid height. Simple prismatic shapes only, no fillets, no fasteners.
*/
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

cellWidth = 2000mm
cellDepth = 1900mm
cellHeight = 3100mm
baseHeight = 160mm
baseRailWidth = 120mm
crossRailHeight = 120mm
columnSize = 180mm
gantryHeight = 220mm
gantryDepth = 180mm
braceWidth = 100mm
braceDepth = 100mm
braceLength = 2738.8mm
braceAngle = 12.86deg

frameColor = "#252b30"
frameAccent = "#3a434a"
cabinetColor = "#b7bec4"
cabinetDoorColor = "#d6dadd"
junctionColor = "#d8a52d"
panelColor = "#313941"

unitBoxSketch = sketch(on = XY) {
  unitBoxCenter = point(at = [var 0mm, var 0mm])
  lowerEdge = line(start = [var -0.5mm, var -0.5mm], end = [var 0.5mm, var -0.5mm])
  rightEdge = line(start = [var 0.5mm, var -0.5mm], end = [var 0.5mm, var 0.5mm])
  upperEdge = line(start = [var 0.5mm, var 0.5mm], end = [var -0.5mm, var 0.5mm])
  leftEdge = line(start = [var -0.5mm, var 0.5mm], end = [var -0.5mm, var -0.5mm])

  coincident([lowerEdge.end, rightEdge.start])
  coincident([rightEdge.end, upperEdge.start])
  coincident([upperEdge.end, leftEdge.start])
  coincident([leftEdge.end, lowerEdge.start])
  coincident([unitBoxCenter, ORIGIN])

  horizontal(lowerEdge)
  vertical(rightEdge)
  horizontal(upperEdge)
  vertical(leftEdge)

  horizontalDistance([unitBoxCenter, lowerEdge.start]) == -0.5mm
  verticalDistance([unitBoxCenter, lowerEdge.start]) == -0.5mm
  horizontalDistance([unitBoxCenter, rightEdge.end]) == 0.5mm
  verticalDistance([unitBoxCenter, rightEdge.end]) == 0.5mm
}

unitBoxRegion = region(point = [0mm, 0mm], sketch = unitBoxSketch)
unitBox = extrude(unitBoxRegion, length = 1mm)
hide(unitBoxSketch)

frontBaseRail = clone(unitBox)
  |> scale(
       x = cellWidth / 1mm,
       y = baseRailWidth / 1mm,
       z = baseHeight / 1mm,
       global = true,
     )
  |> translate(y = -cellDepth / 2 + baseRailWidth / 2, global = true)
  |> appearance(color = frameColor, metalness = 75, roughness = 42)
rearBaseRail = clone(frontBaseRail)
  |> translate(y = cellDepth - baseRailWidth, global = true)
leftBaseRail = clone(unitBox)
  |> scale(
       x = baseRailWidth / 1mm,
       y = (cellDepth - (2 * baseRailWidth)) / 1mm,
       z = baseHeight / 1mm,
       global = true,
     )
  |> translate(x = -cellWidth / 2 + baseRailWidth / 2, global = true)
  |> appearance(color = frameColor, metalness = 75, roughness = 42)
rightBaseRail = clone(leftBaseRail)
  |> translate(x = cellWidth - baseRailWidth, global = true)

frontCrossRail = clone(unitBox)
  |> scale(
       x = (cellWidth - (2 * baseRailWidth)) / 1mm,
       y = 100mm / 1mm,
       z = crossRailHeight / 1mm,
       global = true,
     )
  |> translate(y = -300mm, global = true)
  |> appearance(color = frameAccent, metalness = 72, roughness = 44)
rearCrossRail = clone(frontCrossRail)
  |> translate(y = 600mm, global = true)
centerDepthRail = clone(unitBox)
  |> scale(
       x = 100mm / 1mm,
       y = (cellDepth - (2 * baseRailWidth)) / 1mm,
       z = crossRailHeight / 1mm,
       global = true,
     )
  |> appearance(color = frameAccent, metalness = 72, roughness = 44)

cornerColumn = clone(unitBox)
  |> scale(
       x = columnSize / 1mm,
       y = columnSize / 1mm,
       z = (cellHeight - baseHeight) / 1mm,
       global = true,
     )
  |> translate(
       x = -cellWidth / 2 + columnSize / 2,
       y = cellDepth / 2 - (columnSize / 2),
       z = baseHeight,
       global = true,
     )
  |> appearance(color = frameColor, metalness = 78, roughness = 40)

gantryBeam = clone(unitBox)
  |> scale(
       x = cellWidth / 1mm,
       y = gantryDepth / 1mm,
       z = gantryHeight / 1mm,
       global = true,
     )
  |> translate(y = cellDepth / 2 - (gantryDepth / 2), z = cellHeight - gantryHeight, global = true)
  |> appearance(color = frameColor, metalness = 78, roughness = 40)

diagonalBrace = clone(unitBox)
  |> scale(
       x = braceWidth / 1mm,
       y = braceDepth / 1mm,
       z = braceLength / 1mm,
       global = true,
     )
  |> rotate(pitch = braceAngle, global = true)
  |> translate(
       x = 300mm,
       y = 860mm,
       z = 210mm,
       global = true,
     )
  |> appearance(color = frameAccent, metalness = 76, roughness = 42)

controlCabinet = clone(unitBox)
  |> scale(
       x = 520mm / 1mm,
       y = 500mm / 1mm,
       z = 1340mm / 1mm,
       global = true,
     )
  |> translate(
       x = -500mm,
       y = 475mm,
       z = baseHeight,
       global = true,
     )
  |> appearance(color = cabinetColor, metalness = 48, roughness = 55)
controlCabinetDoor = clone(unitBox)
  |> scale(
       x = 460mm / 1mm,
       y = 20mm / 1mm,
       z = 1220mm / 1mm,
       global = true,
     )
  |> translate(
       x = -500mm,
       y = 215mm,
       z = 230mm,
       global = true,
     )
  |> appearance(color = cabinetDoorColor, metalness = 40, roughness = 58)
controlCabinetPlinth = clone(unitBox)
  |> scale(
       x = 440mm / 1mm,
       y = 420mm / 1mm,
       z = 80mm / 1mm,
       global = true,
     )
  |> translate(
       x = -500mm,
       y = 475mm,
       z = baseHeight,
       global = true,
     )
  |> appearance(color = panelColor, metalness = 64, roughness = 48)

junctionBox = clone(unitBox)
  |> scale(
       x = 280mm / 1mm,
       y = 140mm / 1mm,
       z = 360mm / 1mm,
       global = true,
     )
  |> translate(
       x = -cellWidth / 2 + columnSize / 2 + 50mm,
       y = cellDepth / 2 - columnSize - 70mm,
       z = 1520mm,
       global = true,
     )
  |> appearance(color = junctionColor, metalness = 42, roughness = 56)
junctionBoxDoor = clone(unitBox)
  |> scale(
       x = 240mm / 1mm,
       y = 14mm / 1mm,
       z = 320mm / 1mm,
       global = true,
     )
  |> translate(
       x = -cellWidth / 2 + columnSize / 2 + 50mm,
       y = cellDepth / 2 - columnSize - 147mm,
       z = 1540mm,
       global = true,
     )
  |> appearance(color = "#e5bd55", metalness = 35, roughness = 60)

workCellAssembly = flatten([
  frontBaseRail,
  rearBaseRail,
  leftBaseRail,
  rightBaseRail,
  frontCrossRail,
  rearCrossRail,
  centerDepthRail,
  cornerColumn,
  gantryBeam,
  diagonalBrace,
  controlCabinet,
  controlCabinetDoor,
  controlCabinetPlinth,
  junctionBox,
  junctionBoxDoor
])

workCellAssembly
